# The connection strings the app and tests use by default: the local Postgres in compose.yaml.
# Set these in your environment only to point somewhere else. The credentials are for the
# local container only.
DATABASE_URL=postgresql+psycopg://gta:gta@localhost:5432/gta_dev
TEST_DATABASE_URL=postgresql+psycopg://gta:gta@localhost:5432/gta_test
