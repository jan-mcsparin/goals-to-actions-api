{
  "components": {
    "schemas": {
      "Aspiration": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "retiredOn": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retiredon"
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ],
            "title": "Status",
            "type": "string"
          },
          "why": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Why"
          }
        },
        "required": [
          "id",
          "name",
          "why",
          "status",
          "position",
          "retiredOn",
          "createdAt"
        ],
        "title": "Aspiration",
        "type": "object"
      },
      "AspirationInput": {
        "description": "What the person types. Sent whole on create and on every edit.",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "why": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Why"
          }
        },
        "required": [
          "name"
        ],
        "title": "AspirationInput",
        "type": "object"
      },
      "AspirationList": {
        "properties": {
          "aspirations": {
            "items": {
              "$ref": "#/components/schemas/Aspiration"
            },
            "title": "Aspirations",
            "type": "array"
          }
        },
        "required": [
          "aspirations"
        ],
        "title": "AspirationList",
        "type": "object"
      },
      "AspirationOrder": {
        "description": "Every active aspiration's id, first priority first.",
        "properties": {
          "ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 500,
            "title": "Ids",
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "title": "AspirationOrder",
        "type": "object"
      },
      "ErrorMessage": {
        "description": "FastAPI's error shape, for the errors the API raises itself.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorMessage",
        "type": "object"
      },
      "Goal": {
        "properties": {
          "aspirationId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspirationid"
          },
          "baseline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "endedOn": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Endedon"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "measurableLine": {
            "title": "Measurableline",
            "type": "string"
          },
          "slipped": {
            "description": "Active, with its deadline before today.",
            "title": "Slipped",
            "type": "boolean"
          },
          "startDate": {
            "format": "date",
            "title": "Startdate",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "paused",
              "reached",
              "ended"
            ],
            "title": "Status",
            "type": "string"
          },
          "type": {
            "enum": [
              "building",
              "quitting",
              "oneOff"
            ],
            "title": "Type",
            "type": "string"
          },
          "weeklyTarget": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeeklyTarget"
              },
              {
                "type": "null"
              }
            ],
            "description": "The latest target. Its effectiveFrom is after this week when a change waits for next week. Empty for quitting and one-off goals."
          }
        },
        "required": [
          "id",
          "aspirationId",
          "type",
          "label",
          "measurableLine",
          "baseline",
          "status",
          "startDate",
          "deadline",
          "endedOn",
          "slipped",
          "weeklyTarget",
          "createdAt"
        ],
        "title": "Goal",
        "type": "object"
      },
      "GoalEdit": {
        "description": "Sent whole on every edit. A goal's type and start date don't change.",
        "properties": {
          "aspirationId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspirationid"
          },
          "baseline": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "measurableLine": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Measurableline",
            "type": "string"
          }
        },
        "required": [
          "label",
          "measurableLine"
        ],
        "title": "GoalEdit",
        "type": "object"
      },
      "GoalList": {
        "properties": {
          "goals": {
            "items": {
              "$ref": "#/components/schemas/Goal"
            },
            "title": "Goals",
            "type": "array"
          }
        },
        "required": [
          "goals"
        ],
        "title": "GoalList",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "NewGoal": {
        "description": "A goal as first made. A building goal comes with its first weekly target.",
        "properties": {
          "aspirationId": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Aspirationid"
          },
          "baseline": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline"
          },
          "deadline": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "label": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "measurableLine": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Measurableline",
            "type": "string"
          },
          "startDate": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Today when left out.",
            "title": "Startdate"
          },
          "type": {
            "enum": [
              "building",
              "quitting",
              "oneOff"
            ],
            "title": "Type",
            "type": "string"
          },
          "weeklyTarget": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeeklyTargetInput"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "type",
          "label",
          "measurableLine"
        ],
        "title": "NewGoal",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeeklyTarget": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "effectiveFrom": {
            "format": "date",
            "title": "Effectivefrom",
            "type": "string"
          },
          "kind": {
            "enum": [
              "count",
              "amount"
            ],
            "title": "Kind",
            "type": "string"
          },
          "sessions": {
            "title": "Sessions",
            "type": "integer"
          },
          "unit": {
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "sessions",
          "amount",
          "unit",
          "effectiveFrom"
        ],
        "title": "WeeklyTarget",
        "type": "object"
      },
      "WeeklyTargetInput": {
        "description": "A count (\"3 lifting sessions\") or an amount (\"25 miles over 4 runs\").",
        "properties": {
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 1000000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "kind": {
            "enum": [
              "count",
              "amount"
            ],
            "title": "Kind",
            "type": "string"
          },
          "sessions": {
            "maximum": 14.0,
            "minimum": 1.0,
            "title": "Sessions",
            "type": "integer"
          },
          "unit": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Unit",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "sessions",
          "unit"
        ],
        "title": "WeeklyTargetInput",
        "type": "object"
      }
