  "paths": {
    "/api/aspirations": {
      "get": {
        "operationId": "listAspirations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AspirationList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Aspirations",
        "tags": [
          "aspirations"
        ]
      }
    },
    "/api/aspirations/reorder": {
      "post": {
        "operationId": "reorderAspirations",
