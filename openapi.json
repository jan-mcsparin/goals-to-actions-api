{
  "components": {
    "schemas": {
      "Aspiration": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "retiredOn": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retiredon"
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ],
            "title": "Status",
            "type": "string"
          },
          "why": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Why"
          }
        },
        "required": [
          "id",
          "name",
          "why",
          "status",
          "position",
          "retiredOn",
          "createdAt"
        ],
        "title": "Aspiration",
        "type": "object"
      },
      "AspirationInput": {
        "description": "What the person types. Sent whole on create and on every edit.",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "why": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Why"
          }
        },
        "required": [
          "name"
        ],
        "title": "AspirationInput",
        "type": "object"
      },
      "AspirationList": {
        "properties": {
          "aspirations": {
            "items": {
              "$ref": "#/components/schemas/Aspiration"
            },
            "title": "Aspirations",
            "type": "array"
          }
        },
        "required": [
          "aspirations"
        ],
        "title": "AspirationList",
        "type": "object"
      },
      "AspirationOrder": {
        "description": "Every active aspiration's id, first priority first.",
        "properties": {
          "ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "maxItems": 500,
            "title": "Ids",
            "type": "array"
          }
        },
        "required": [
          "ids"
        ],
        "title": "AspirationOrder",
        "type": "object"
      },
      "ErrorMessage": {
        "description": "FastAPI's error shape, for the errors the API raises itself.",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorMessage",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Goals to Actions API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/aspirations": {
      "get": {
        "operationId": "listAspirations",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AspirationList"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Aspirations",
        "tags": [
          "aspirations"
        ]
      }
    },
    "/api/aspirations/reorder": {
      "post": {
        "operationId": "reorderAspirations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AspirationOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AspirationList"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            },
            "description": "The rules don't allow this change."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Reorder Aspirations",
        "tags": [
          "aspirations"
        ]
      }
    },
    "/api/aspirations/{aspiration_id}": {
      "patch": {
        "operationId": "updateAspiration",
        "parameters": [
          {
            "in": "path",
            "name": "aspiration_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Aspiration Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AspirationInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aspiration"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            },
            "description": "No such row, or it belongs to someone else."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Update Aspiration",
        "tags": [
          "aspirations"
        ]
      },
      "put": {
        "operationId": "createAspiration",
        "parameters": [
          {
            "in": "path",
            "name": "aspiration_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Aspiration Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AspirationInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aspiration"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            },
            "description": "The rules don't allow this change."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Aspiration",
        "tags": [
          "aspirations"
        ]
      }
    },
    "/api/aspirations/{aspiration_id}/bring-back": {
      "post": {
        "operationId": "bringBackAspiration",
        "parameters": [
          {
            "in": "path",
            "name": "aspiration_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Aspiration Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aspiration"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            },
            "description": "No such row, or it belongs to someone else."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Bring Back Aspiration",
        "tags": [
          "aspirations"
        ]
      }
    },
    "/api/aspirations/{aspiration_id}/retire": {
      "post": {
        "operationId": "retireAspiration",
        "parameters": [
          {
            "in": "path",
            "name": "aspiration_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Aspiration Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-time-zone",
            "required": true,
            "schema": {
              "title": "X-Time-Zone",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aspiration"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorMessage"
                }
              }
            },
            "description": "No such row, or it belongs to someone else."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Retire Aspiration",
        "tags": [
          "aspirations"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
